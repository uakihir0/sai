use acme:marsh-survey-review/model.{Confidence, Observation, Species, Survey, Transect}
use sai:core/num.{U32_MAX}

pub fn coastal_survey() -> Survey {
    Survey(
        observation_count: 5,
        observations: [
            Some(
                Observation(
                    id: 101,
                    transect: Transect.NorthChannel,
                    species: Species.MarshSparrow,
                    count: 8,
                    confidence: Confidence.High,
                ),
            ),
            Some(
                Observation(
                    id: 102,
                    transect: Transect.NorthChannel,
                    species: Species.TurtleNest,
                    count: 2,
                    confidence: Confidence.High,
                ),
            ),
            Some(
                Observation(
                    id: 103,
                    transect: Transect.SouthDunes,
                    species: Species.Cordgrass,
                    count: 20,
                    confidence: Confidence.High,
                ),
            ),
            Some(
                Observation(
                    id: 104,
                    transect: Transect.SouthDunes,
                    species: Species.FiddlerCrab,
                    count: 0,
                    confidence: Confidence.High,
                ),
            ),
            Some(
                Observation(
                    id: 105,
                    transect: Transect.SouthDunes,
                    species: Species.Rail,
                    count: 5,
                    confidence: Confidence.Low,
                ),
            ),
            None,
            None,
            None,
        ],
    )
}

pub fn empty_survey() -> Survey {
    Survey(observation_count: 0, observations: Array<Option<Observation>, 8>.filled(None))
}

pub fn oversized_survey() -> Survey {
    Survey(observation_count: 9, observations: Array<Option<Observation>, 8>.filled(None))
}

