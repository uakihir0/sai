use acme:privacy-request-coordinator/model.{
    DataClass
    DataStore
    DataSubjectRequest
    DeletionDependency
    DeletionReceipt
    MAX_DEPENDENCIES
    MAX_RECEIPTS
    MAX_RECORDS
    ReceiptOutcome
    RequestKind
    StoreRecord
}

pub fn request() -> DataSubjectRequest {
    DataSubjectRequest(
        request_id: 9001,
        subject_id: 501,
        kind: RequestKind.AccessAndErasure,
        received_minute: 1490,
        identity_verified: true,
        scope_confirmed: true,
    )
}

