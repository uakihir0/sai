            subject_id: 501,
            store: DataStore.SearchIndex,
            data_class: DataClass.SearchDocument,
            retained_until_minute: None,
            legal_hold: false,
        ),
        StoreRecord(
            record_id: 8102,
            operation_key: 90012,
            subject_id: 501,
            store: DataStore.MarketingPlatform,
            data_class: DataClass.MarketingPreference,
            retained_until_minute: None,
            legal_hold: false,
        ),
        StoreRecord(
            record_id: 8103,
            operation_key: 90013,
            subject_id: 501,
            store: DataStore.SessionCache,
            data_class: DataClass.SessionToken,
            retained_until_minute: None,
            legal_hold: false,
        ),
        StoreRecord(
            record_id: 8104,
            operation_key: 90014,
            subject_id: 501,
            store: DataStore.ProfileService,
            data_class: DataClass.Profile,
            retained_until_minute: None,
