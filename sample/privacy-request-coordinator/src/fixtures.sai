pub fn dependencies() -> Array<DeletionDependency, MAX_DEPENDENCIES> {
    [
        DeletionDependency(before_record_id: 8101, after_record_id: 8104),
        DeletionDependency(before_record_id: 8102, after_record_id: 8104),
        DeletionDependency(before_record_id: 8103, after_record_id: 8104),
    ]
}

pub fn receipts() -> Array<Option<DeletionReceipt>, MAX_RECEIPTS> {
    var result = Array<Option<DeletionReceipt>, MAX_RECEIPTS>.filled(None)
    result[0] = Some(
        DeletionReceipt(
            record_id: 8101,
            operation_key: 90011,
            attempt: 1,
            outcome: ReceiptOutcome.Succeeded,
        ),
    )
    result[1] = Some(
        DeletionReceipt(
            record_id: 8102,
            operation_key: 90012,
            attempt: 1,
            outcome: ReceiptOutcome.RetryableFailure,
        ),
    )
    result[2] = Some(
        DeletionReceipt(
            record_id: 8102,
            operation_key: 90012,
            attempt: 2,
            outcome: ReceiptOutcome.Succeeded,
        ),
    )
    result[3] = Some(
        DeletionReceipt(
            record_id: 8103,
            operation_key: 90013,
            attempt: 1,
            outcome: ReceiptOutcome.RetryableFailure,
        ),
    )
    result[4] = Some(
        DeletionReceipt(
            record_id: 8103,
            operation_key: 90013,
            attempt: 2,
            outcome: ReceiptOutcome.RetryableFailure,
        ),
    )
    result
}

pub fn receipt_count() -> USize {
    5
}
