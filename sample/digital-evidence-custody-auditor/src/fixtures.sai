use acme:digital-evidence-custody-auditor/model.{
    AccessPurpose
    Actor
    CustodyAction
    CustodyEvent
    Disposition
    EvidenceItem
    StorageLocation
}

pub fn evidence() -> Array<EvidenceItem, 4> {
    [
        EvidenceItem(
            evidence_id: 4101,
            description: "field laptop",
            required_disposition: Disposition.RetainInArchive,
        ),
        EvidenceItem(
            evidence_id: 4102,
            description: "removable USB drive",
            required_disposition: Disposition.ReturnToOwner,
        ),
        EvidenceItem(
            evidence_id: 4103,
            description: "damaged mobile phone",
            required_disposition: Disposition.DestroyAfterReview,
        ),
        EvidenceItem(
            evidence_id: 4104,
            description: "encrypted external disk",
            required_disposition: Disposition.RetainInArchive,
        ),
    ]
}

pub fn actors() -> Array<Actor, 4> {
    [
        Actor(
            actor_id: 501,
            display_name: "Mira Chen",
            may_collect: true,
            may_apply_seal: true,
            may_break_seal: false,
            may_move: false,
            may_access: false,
            may_dispose: false,
            allowed_purposes: Array<Option<AccessPurpose>, 4>.filled(None),
        ),
        Actor(
            actor_id: 502,
            display_name: "Ravi Patel",
            may_collect: false,
            may_apply_seal: false,
            may_break_seal: true,
            may_move: false,
            may_access: true,
            may_dispose: false,
            allowed_purposes: [
                Some(AccessPurpose.ForensicImaging),
                Some(AccessPurpose.HashVerification),
                None,
                None,
            ],
        ),
        Actor(
            actor_id: 503,
            display_name: "Omar Reyes",
            may_collect: false,
            may_apply_seal: false,
            may_break_seal: false,
            may_move: true,
            may_access: false,
            may_dispose: false,
            allowed_purposes: Array<Option<AccessPurpose>, 4>.filled(None),
        ),
        Actor(
            actor_id: 504,
            display_name: "Inez Walker",
            may_collect: true,
            may_apply_seal: true,
            may_break_seal: true,
            may_move: true,
            may_access: true,
            may_dispose: true,
            allowed_purposes: [
                Some(AccessPurpose.ForensicImaging),
                Some(AccessPurpose.HashVerification),
                Some(AccessPurpose.LegalReview),
                Some(AccessPurpose.MalwareAnalysis),
