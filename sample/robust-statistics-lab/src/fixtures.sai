use acme:robust-statistics-lab/model

// The readings are scaled integer units from fictional equipment. The outlier
// in each batch is intentionally retained in source order for the report.
pub fn batches() -> Array<model.MeasurementBatch, 3> {
    [
        model.MeasurementBatch(
            sensor_id: 10,
            sensor_name: "North greenhouse probe",
            readings: [9, 10, 10, 11, 12, 12, 13, 14, 100],
        ),
        model.MeasurementBatch(
            sensor_id: 20,
            sensor_name: "Riverside probe",
            readings: [19, 20, 21, 20, 19, 20, 21, 22, 20],
        ),
        model.MeasurementBatch(
            sensor_id: 30,
            sensor_name: "Market cold-room probe",
            readings: [7, 7, 7, 7, 7, 7, 7, 7, 20],
        ),
    ]
}
