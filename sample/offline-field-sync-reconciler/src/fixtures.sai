fn stale_and_fresh_patch_case() -> SyncCase {
    var case = empty_case(
        WorkOrder(
            id: 4108,
            summary: "inspect chiller",
            status: WorkStatus.InProgress,
            assignee: Some(29),
            due_day: Some(127),
        ),
        6,
        5,
    )
    case.server_changes[0] = Some(
        ServerChange(
            revision: 6,
            field: WorkField.Status,
            value: FieldValue.Status(WorkStatus.InProgress),
        ),
    )
    case.server_change_count = 1
    case.local_patches[0] = Some(
        LocalPatch(
            client_id: 70,
            event_id: 11101,
            base_revision: 4,
            field: WorkField.Summary,
            value: FieldValue.Summary("check chiller compressor"),
        ),
    )
    case.local_patches[1] = Some(
        LocalPatch(
            client_id: 70,
            event_id: 11102,
            base_revision: 6,
            field: WorkField.Summary,
            value: FieldValue.Summary("inspect the chiller compressor"),
        ),
    )
    case.local_patch_count = 2
    case
}

pub fn sample_batch() -> SyncBatch {
    var cases = Array<Option<SyncCase>, MAX_SYNC_CASES>.filled(None)
    cases[0] = Some(independent_edit_case())
    cases[1] = Some(remote_conflict_case())
    cases[2] = Some(independent_fields_case())
    cases[3] = Some(duplicate_arrival_case())
    cases[4] = Some(delete_update_conflict_case())
    cases[5] = Some(event_id_collision_case())
    cases[6] = Some(offline_field_conflict_case())
    cases[7] = Some(stale_and_fresh_patch_case())
    SyncBatch(cases: cases, case_count: 8)
}
