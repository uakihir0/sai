use acme:workbook-recalculator/model.{Formula, FormulaOperator}
use sai:core/num.{U32_MAX}

@derive(Copy, Clone, PartialEq, Eq)
pub enum FormulaError {
    ArithmeticRangeError
    DivisionByZero
}

pub fn evaluate(formula: Formula, left: U32, right: U32) -> Result<U32, FormulaError> {
    match formula.operator {
        FormulaOperator.Add => {
            if left > U32_MAX - right {
                Err(FormulaError.ArithmeticRangeError)
            } else {
                Ok(left + right)
            }
        }
        FormulaOperator.Subtract => {
            if left < right {
                Err(FormulaError.ArithmeticRangeError)
            } else {
                Ok(left - right)
            }
        }
        FormulaOperator.Multiply => {
            if right == 0 {
                Ok(0)
            } else if left > U32_MAX / right {
                Err(FormulaError.ArithmeticRangeError)
            } else {
                Ok(left * right)
            }
        }
        FormulaOperator.Divide => {
            if right == 0 {
                Err(FormulaError.DivisionByZero)
            } else {
                Ok(left / right)
            }
        }
    }
}
