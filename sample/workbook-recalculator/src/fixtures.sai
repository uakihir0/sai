use acme:workbook-recalculator/model.{
    Cell
    CellExpression
    Formula
    FormulaOperator
    MAX_CELLS
    Workbook
}

fn literal(id: U32, label: Str, value: U32) -> Cell {
    Cell(id: id, label: label, expression: CellExpression.Literal(value))
}

fn formula(id: U32, label: Str, left: U32, operator: FormulaOperator, right: U32) -> Cell {
    Cell(
        id: id,
        label: label,
        expression: CellExpression.Formula(Formula(left: left, operator: operator, right: right)),
    )
}

pub fn workbook() -> Workbook {
    var cells = Array<Option<Cell>, MAX_CELLS>.filled(None)
    cells[0] = Some(formula(101, "Net", 20, FormulaOperator.Subtract, 60))
    cells[1] = Some(formula(60, "Tax", 50, FormulaOperator.Divide, 100))
    cells[2] = Some(formula(20, "Gross", 10, FormulaOperator.Multiply, 11))
    cells[3] = Some(literal(10, "Hours", 8))
    cells[4] = Some(literal(11, "Rate", 25))
    cells[5] = Some(formula(50, "Tax base", 20, FormulaOperator.Multiply, 40))
    cells[6] = Some(literal(40, "Tax percent", 15))
    cells[7] = Some(formula(80, "Missing input", 20, FormulaOperator.Add, 999))
    cells[8] = Some(formula(90, "Cycle A", 91, FormulaOperator.Add, 10))
    cells[9] = Some(formula(91, "Cycle B", 90, FormulaOperator.Add, 10))
    cells[10] = Some(formula(92, "Cycle downstream", 90, FormulaOperator.Add, 10))
    cells[11] = Some(formula(93, "Overflow", 94, FormulaOperator.Add, 10))
    cells[12] = Some(literal(94, "Largest U32", 4294967295))
    cells[13] = Some(formula(95, "Overflow downstream", 93, FormulaOperator.Add, 10))
    cells[14] = Some(formula(96, "Divide by zero", 10, FormulaOperator.Divide, 30))
    cells[15] = Some(literal(30, "Zero", 0))
    cells[16] = Some(formula(97, "Division downstream", 96, FormulaOperator.Add, 10))
    cells[17] = Some(literal(100, "Percent base", 100))
    cells[18] = Some(formula(81, "Missing downstream", 80, FormulaOperator.Add, 10))
    Workbook(cells: cells, cell_count: 19)
}

pub fn duplicate_id_workbook() -> Workbook {
    var sheet = workbook()
    sheet.cells[1] = Some(literal(10, "Duplicate hours", 3))
    sheet
}
