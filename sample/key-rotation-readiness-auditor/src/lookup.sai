pub fn workload_index(workloads: Array<Workload, 5>, workload_id: U32) -> Result<
    USize,
    AuditIssue,
> {
    var found: Option<USize> = None
    for index in 0..workloads.len() {
        if workloads[index].id == workload_id {
            match found {
                Some(_) => return Err(AuditIssue.DuplicateWorkloadId)
                None => {
                    found = Some(index)
                }
            }
        }
    }
    match found { Some(index) => Ok(index), None => Err(AuditIssue.MissingMigrationEvidence) }
