    var found: Option<USize> = None
    for index in 0..evidence.len() {
        if evidence[index].workload_id == workload_id {
            match found {
                Some(_) => return Err(AuditIssue.AmbiguousMigrationEvidence)
                None => {
                    found = Some(index)
                }
            }
        }
    }
    match found { Some(index) => Ok(index), None => Err(AuditIssue.MissingMigrationEvidence) }
}
