use acme:canary-release-safety-planner/lookup
use acme:canary-release-safety-planner/model.{Dependency, GraphIssue, Service, ServiceOrder}

fn service_exists(services: Array<Service, 4>, service_id: U32) -> Bool {
    match lookup.service_index(services, service_id) { Some(_) => true, None => false }
}

pub fn validate_graph(services: Array<Service, 4>, dependencies: Array<Dependency, 4>) -> Option<
    GraphIssue,
> {
    for index in 0..services.len() {
        for other_index in (index + 1)..services.len() {
            if services[index].id == services[other_index].id {
                return Some(GraphIssue.DuplicateServiceId)
            }
        }
    }

    for index in 0..dependencies.len() {
        let dependency = dependencies[index]
        if dependency.service_id == dependency.prerequisite_id {
            return Some(GraphIssue.SelfDependency)
        }
        if (
            not service_exists(services, dependency.service_id)
            or not service_exists(services, dependency.prerequisite_id)
        ) {
            return Some(GraphIssue.UnknownDependencyEndpoint)
        }
        for other_index in (index + 1)..dependencies.len() {
            if (
                dependencies[other_index].service_id == dependency.service_id
                and dependencies[other_index].prerequisite_id == dependency.prerequisite_id
            ) {
                return Some(GraphIssue.DuplicateDependency)
            }
        }
    }

    None
}

fn dependencies_are_ordered(
    services: Array<Service, 4>,
    dependencies: Array<Dependency, 4>,
    service_id: U32,
    ordered: Array<Bool, 4>,
) -> Bool {
    for dependency in dependencies {
        if dependency.service_id == service_id {
            match lookup.service_index(services, dependency.prerequisite_id) {
                Some(index) => {
                    if not ordered[index] {
                        return false
                    }
                }
                None => {
                    return false
                }
            }
        }
    }
    true
}

fn first_ready_index(
    services: Array<Service, 4>,
    dependencies: Array<Dependency, 4>,
    ordered: Array<Bool, 4>,
) -> Option<USize> {
    var selected: Option<USize> = None
    for index in 0..services.len() {
        if (
            not ordered[index]
            and dependencies_are_ordered(services, dependencies, services[index].id, ordered)
        ) {
            match selected {
                Some(selected_index) => {
                    if services[index].id < services[selected_index].id {
                        selected = Some(index)
                    }
                }
                None => {
                    selected = Some(index)
                }
            }
        }
    }
    selected
}

pub fn order_services(
    services: Array<Service, 4>,
    dependencies: Array<Dependency, 4>,
) -> ServiceOrder {
    var service_ids = Array<Option<U32>, 4>.filled(None)
    var length: USize = 0
    var issue = validate_graph(services, dependencies)

    if issue.is_none() {
        var ordered = Array<Bool, 4>.filled(false)
        var stuck = false
        while length < services.len() and not stuck {
            match first_ready_index(services, dependencies, ordered) {
                Some(index) => {
                    ordered[index] = true
                    service_ids[length] = Some(services[index].id)
                    length += 1
                }
                None => {
                    stuck = true
                }
            }
        }
        if length < services.len() {
            issue = Some(GraphIssue.DependencyCycle)
            service_ids = Array<Option<U32>, 4>.filled(None)
            length = 0
        }
    }

    ServiceOrder(service_ids: service_ids, length: length, issue: issue)
}
