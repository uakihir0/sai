use acme:bounded-expression-evaluator/model.{Token, TokenKind, TokenStream}
use sai:core/num.{U32_MAX}

pub fn nested_precedence() -> TokenStream {
    TokenStream(
        items: [
            Some(Token(kind: TokenKind.Number, value: 2, offset: 0)),
            Some(Token(kind: TokenKind.Plus, value: 0, offset: 2)),
            Some(Token(kind: TokenKind.Number, value: 3, offset: 4)),
            Some(Token(kind: TokenKind.Multiply, value: 0, offset: 6)),
            Some(Token(kind: TokenKind.LeftParen, value: 0, offset: 8)),
            Some(Token(kind: TokenKind.Number, value: 4, offset: 9)),
            Some(Token(kind: TokenKind.Minus, value: 0, offset: 11)),
            Some(Token(kind: TokenKind.Number, value: 1, offset: 13)),
            Some(Token(kind: TokenKind.RightParen, value: 0, offset: 14)),
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
        ],
        len: 9,
    )
}

pub fn left_associative_subtraction() -> TokenStream {
    TokenStream(
        items: [
            Some(Token(kind: TokenKind.Number, value: 8, offset: 0)),
            Some(Token(kind: TokenKind.Minus, value: 0, offset: 2)),
            Some(Token(kind: TokenKind.Number, value: 3, offset: 4)),
            Some(Token(kind: TokenKind.Minus, value: 0, offset: 6)),
            Some(Token(kind: TokenKind.Number, value: 2, offset: 8)),
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
        ],
        len: 5,
    )
}

pub fn division_by_zero() -> TokenStream {
    TokenStream(
        items: [
            Some(Token(kind: TokenKind.Number, value: 9, offset: 0)),
            Some(Token(kind: TokenKind.Divide, value: 0, offset: 2)),
            Some(Token(kind: TokenKind.Number, value: 0, offset: 4)),
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
        ],
        len: 3,
    )
}

pub fn addition_overflow() -> TokenStream {
    TokenStream(
        items: [
            Some(Token(kind: TokenKind.Number, value: U32_MAX, offset: 0)),
            Some(Token(kind: TokenKind.Plus, value: 0, offset: 11)),
            Some(Token(kind: TokenKind.Number, value: 1, offset: 13)),
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
        ],
        len: 3,
    )
}
