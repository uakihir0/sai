@derive(Copy, Clone, PartialEq, Eq)
pub enum FormatRisk {
    Stable
    Watch
    Obsolete
}

@derive(Copy, Clone, PartialEq, Eq)
pub enum FixityState {
    Verified
    Missing
    Mismatch
}

@derive(Copy, Clone, PartialEq, Eq)
pub enum PreservationPermission {
    Approved
    Pending
    Denied
}

@derive(Copy, Clone, PartialEq, Eq)
pub enum Action {
    Migrate
    Replicate
}

@derive(Copy, Clone, PartialEq, Eq)
pub enum Outcome {
    Scheduled
    Current
    Held
    Deferred
}

@derive(Copy, Clone, PartialEq, Eq)
pub enum Finding {
    FixityNotRecorded
    FixityMismatch
    NoVerifiedCopy
    PermissionPending
    PermissionDenied
    MigrationPathUncertified
    ReplicationShortfallExceedsBound
    MigrationByteBudgetExceeded
    ReplicationByteBudgetExceeded
    MigrationTaskLimitReached
    ReplicationTaskLimitReached
}

@derive(Copy, Clone, PartialEq, Eq)
pub type ArchiveItem {
    pub record_id: U32
    pub title: Str
    pub size_bytes: U32
    pub format_risk: FormatRisk
    pub fixity: FixityState
    pub permission: PreservationPermission
    pub migration_path_certified: Bool
    pub independent_copy_domains: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type PlanInput {
    pub items: Array<Option<ArchiveItem>, 8>
    pub item_count: USize
    pub minimum_copy_domains: U32
    pub migration_byte_budget: U32
    pub replication_byte_budget: U32
    pub migration_task_limit: U32
    pub replication_task_limit: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Candidate {
    pub input_index: USize
    pub record_id: U32
    pub size_bytes: U32
    pub risk_rank: U32
    pub independent_copy_domains: U32
    pub task_count: U32
    pub action: Action
}

@derive(Copy, Clone, PartialEq, Eq)
pub type ItemPlan {
    pub record_id: U32
    pub outcome: Outcome
    pub action: Option<Action>
    pub finding: Option<Finding>
    pub size_bytes: U32
    pub task_count: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type PlanReport {
    pub items: Array<Option<ItemPlan>, 8>
    pub item_count: USize
    pub migrations_scheduled: U32
    pub replications_scheduled: U32
    pub migration_bytes: U32
    pub replication_bytes: U32
    pub held_count: USize
    pub deferred_count: USize
    pub current_count: USize
}
