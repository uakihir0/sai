@derive(Copy, Clone, PartialEq, Eq)
pub enum Kind {
    Opening
    Headline
    Interview
    Break
    ListenerMail
    Calendar
    Music
    BehindScenes
    Closing
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Segment {
    pub id: U32
    pub title: Str
    pub kind: Kind
    pub duration_minutes: U32
    pub optional: Bool
}

@derive(Copy, Clone, PartialEq, Eq)
pub type ScheduledSegment {
    pub segment: Segment
    pub start_minute: U32
    pub end_minute: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Plan {
    pub entries: Array<Option<ScheduledSegment>, 10>
    pub len: USize
    pub total_minutes: U32
    pub skipped_optional: U32
}
