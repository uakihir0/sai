use acme:api-rate-limit-simulator/limiter
use acme:api-rate-limit-simulator/model.{Admission, Decision, Report}
use acme:api-rate-limit-simulator/policy

pub fn sample_report() -> Report {
    limiter.simulate()
}

fn admission(report: Report, index: USize) -> Admission {
    report.admissions[index].unwrap()
}

test "the interleaved fixture enforces independent client budgets" {
    let report = sample_report()
    assert report.allowed_count == 9
    assert report.rate_limited_count == 2
    assert report.unknown_client_count == 1

    assert admission(report, 3).decision == Decision.RateLimited
    assert admission(report, 3).retry_at_seconds == 10
    assert admission(report, 3).retry_after_seconds == 1
    assert admission(report, 4).decision == Decision.Allowed
}

test "the exact boundary begins a fresh window for each client" {
    let report = sample_report()
    assert admission(report, 5).decision == Decision.Allowed
    assert admission(report, 6).decision == Decision.Allowed
    assert admission(report, 8).decision == Decision.RateLimited
    assert admission(report, 8).retry_at_seconds == 20
    assert admission(report, 8).retry_after_seconds == 1
    assert admission(report, 10).decision == Decision.Allowed

    assert report.clients[0].window_start_seconds == 20
    assert report.clients[0].admitted_count == 1
    assert report.clients[1].window_start_seconds == 10
    assert report.clients[1].admitted_count == 2
}

test "an unknown client does not receive or consume a configured bucket" {
    let report = sample_report()
    assert admission(report, 11).decision == Decision.UnknownClient
    assert report.clients[0].client_id == 101
    assert report.clients[1].client_id == 202
}

test "retry calculations honor half-open window boundaries" {
    assert policy.window_start(9) == 0
    assert policy.window_start(10) == 10
    assert policy.retry_at(9) == 10
    assert policy.retry_after(9) == 1
    assert policy.retry_at(10) == 20
    assert policy.retry_after(10) == 10
}
