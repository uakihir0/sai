use acme:urban-tree-planting-planner/model.{
    Drainage
    HoldReason
    PlantingDecision
    PlantingPlan
    PlantingSite
    TreeSpecies
}

fn site_precedes(left: PlantingSite, right: PlantingSite) -> Bool {
    if left.priority != right.priority {
        return left.priority < right.priority
    }
    left.id < right.id
}

fn fits_site(species: TreeSpecies, site: PlantingSite) -> Bool {
    (
        species.drainage == site.drainage
        and site.usable_root_volume_ft3 >= species.minimum_root_volume_ft3
        and site.overhead_clearance_ft >= species.minimum_overhead_clearance_ft
        and site.sidewalk_width_ft >= species.minimum_sidewalk_width_ft
    )
}

fn species_count_in_district(
    decisions: Array<Option<PlantingDecision>, 10>,
    decision_count: USize,
    district_id: U32,
    species_id: U32,
) -> USize {
    var count: USize = 0
    for index in 0..decision_count {
        match decisions[index] {
            Some(decision) => {
                if decision.district_id == district_id and decision.species_id == Some(species_id) {
                    count += 1
                }
            }
            None => {}
        }
    }
    count
}

fn choice_precedes(
    candidate: TreeSpecies,
    current: TreeSpecies,
    site: PlantingSite,
    decisions: Array<Option<PlantingDecision>, 10>,
    decision_count: USize,
) -> Bool {
    let candidate_count =
        species_count_in_district(decisions, decision_count, site.district_id, candidate.id)
    let current_count =
        species_count_in_district(decisions, decision_count, site.district_id, current.id)
    if candidate_count != current_count {
        return candidate_count < current_count
    }
    if candidate.establishment_water_liters != current.establishment_water_liters {
        return candidate.establishment_water_liters < current.establishment_water_liters
    }
    candidate.id < current.id
}

fn choose_species(
    site: PlantingSite,
    species: Array<TreeSpecies, 4>,
    remaining_stock: Array<USize, 4>,
    decisions: Array<Option<PlantingDecision>, 10>,
    decision_count: USize,
    remaining_water_liters: U32,
    district_limit: USize,
) -> (Option<USize>, Option<HoldReason>) {
    var best: Option<USize> = None
    var saw_site_fit = false
    var saw_stock = false
    var saw_diversity_slot = false
    var saw_water = false

    for index in 0..species.len() {
        let candidate = species[index]
        if not fits_site(candidate, site) {
            continue
        }
        saw_site_fit = true
        if remaining_stock[index] == 0 {
            continue
        }
        saw_stock = true

        let district_count =
            species_count_in_district(decisions, decision_count, site.district_id, candidate.id)
        if district_count >= district_limit {
            continue
        }
        saw_diversity_slot = true
        if candidate.establishment_water_liters > remaining_water_liters {
            continue
        }
        saw_water = true

        match best {
            Some(current_index) => {
                let current = species[current_index]
                if choice_precedes(candidate, current, site, decisions, decision_count) {
                    best = Some(index)
                }
            }
            None => {
                best = Some(index)
            }
        }
    }

    match best {
        Some(species_index) => (Some(species_index), None)
        None => {
            let reason = if not saw_site_fit {
                HoldReason.NoSuitableSpecies
            } else if not saw_stock {
                HoldReason.NurseryStockUnavailable
            } else if not saw_diversity_slot {
                HoldReason.DistrictDiversityLimit
            } else if not saw_water {
                HoldReason.SharedWaterBudgetExceeded
            } else {
                HoldReason.NoSuitableSpecies
            }
            (None, Some(reason))
        }
    }
}

pub fn plan(
    sites: Array<PlantingSite, 10>,
    species: Array<TreeSpecies, 4>,
    district_limit: USize,
    water_budget_liters: U32,
) -> PlantingPlan {
    var ordered = sites
    for index in 1..ordered.len() {
        let candidate = ordered[index]
        var cursor = index
        while cursor > 0 {
            if site_precedes(candidate, ordered[cursor - 1]) {
                ordered[cursor] = ordered[cursor - 1]
                cursor -= 1
            } else {
                break
            }
        }
        ordered[cursor] = candidate
    }

    var decisions: Array<Option<PlantingDecision>, 10> =
        [None, None, None, None, None, None, None, None, None, None]
    var remaining_stock = Array<USize, 4>.filled(0)
    for index in 0..species.len() {
        remaining_stock[index] = species[index].nursery_stock
    }

    var water_reserved_liters: U32 = 0
    var planted_count: USize = 0
    var held_count: USize = 0

    for index in 0..ordered.len() {
        let site = ordered[index]
        let remaining_water_liters = water_budget_liters - water_reserved_liters
        let (selected, hold_reason) = choose_species(
            site,
            species,
            remaining_stock,
            decisions,
            index,
            remaining_water_liters,
            district_limit,
        )
        match selected {
            Some(species_index) => {
                let tree = species[species_index]
                remaining_stock[species_index] -= 1
                water_reserved_liters += tree.establishment_water_liters
                planted_count += 1
                decisions[index] = Some(
                    PlantingDecision(
                        site_id: site.id,
                        site_name: site.name,
                        district_id: site.district_id,
                        priority: site.priority,
                        species_id: Some(tree.id),
                        hold_reason: None,
                        establishment_water_liters: tree.establishment_water_liters,
                    ),
                )
            }
            None => {
                held_count += 1
                decisions[index] = Some(
                    PlantingDecision(
                        site_id: site.id,
                        site_name: site.name,
                        district_id: site.district_id,
                        priority: site.priority,
                        species_id: None,
                        hold_reason: hold_reason,
                        establishment_water_liters: 0,
                    ),
                )
            }
        }
    }

    PlantingPlan(
        decisions: decisions,
        decision_count: ordered.len(),
        planted_count: planted_count,
        held_count: held_count,
        water_reserved_liters: water_reserved_liters,
        water_budget_liters: water_budget_liters,
    )
}

test "duplicate species IDs consume only the selected stock entry" {
    let site = PlantingSite(
        id: 1,
        name: "Training Site",
        district_id: 1,
        priority: 1,
        drainage: Drainage.Moist,
        usable_root_volume_ft3: 30,
        overhead_clearance_ft: 12,
        sidewalk_width_ft: 3,
    )
    let sites = [site, site, site, site, site, site, site, site, site, site]
    let species = [
        TreeSpecies(
            id: 7,
            name: "Unstocked Serviceberry",
            drainage: Drainage.Moist,
            minimum_root_volume_ft3: 20,
            minimum_overhead_clearance_ft: 10,
            minimum_sidewalk_width_ft: 2,
            establishment_water_liters: 28,
            nursery_stock: 0,
        ),
        TreeSpecies(
            id: 7,
            name: "Available Serviceberry",
            drainage: Drainage.Moist,
            minimum_root_volume_ft3: 20,
            minimum_overhead_clearance_ft: 10,
            minimum_sidewalk_width_ft: 2,
            establishment_water_liters: 28,
            nursery_stock: 1,
        ),
        TreeSpecies(
            id: 8,
            name: "Poor-Drainage Oak",
            drainage: Drainage.PoorlyDrained,
            minimum_root_volume_ft3: 20,
            minimum_overhead_clearance_ft: 10,
            minimum_sidewalk_width_ft: 2,
            establishment_water_liters: 40,
            nursery_stock: 1,
        ),
        TreeSpecies(
            id: 9,
            name: "Well-Drained Ironwood",
            drainage: Drainage.WellDrained,
            minimum_root_volume_ft3: 20,
            minimum_overhead_clearance_ft: 10,
            minimum_sidewalk_width_ft: 2,
            establishment_water_liters: 40,
            nursery_stock: 1,
        ),
    ]
    let result = plan(sites, species, 10, 300)
    assert result.planted_count == 1
    assert result.held_count == 9
    assert result.decisions[0].unwrap().species_id == Some(7)
    assert result.decisions[1].unwrap().hold_reason == Some(HoldReason.NurseryStockUnavailable)
}

test "hold reasons report the furthest eligibility gate reached" {
    let site = PlantingSite(
        id: 1,
        name: "Training Site",
        district_id: 1,
        priority: 1,
        drainage: Drainage.Moist,
        usable_root_volume_ft3: 30,
        overhead_clearance_ft: 12,
        sidewalk_width_ft: 3,
    )
    let unstocked = TreeSpecies(
        id: 1,
        name: "Unstocked Serviceberry",
        drainage: Drainage.Moist,
        minimum_root_volume_ft3: 20,
        minimum_overhead_clearance_ft: 10,
        minimum_sidewalk_width_ft: 2,
        establishment_water_liters: 28,
        nursery_stock: 0,
    )
    let district_limited = TreeSpecies(
        id: 2,
        name: "District-Limited Serviceberry",
        drainage: Drainage.Moist,
        minimum_root_volume_ft3: 20,
        minimum_overhead_clearance_ft: 10,
        minimum_sidewalk_width_ft: 2,
        establishment_water_liters: 28,
        nursery_stock: 1,
    )
    let unfit = [
        TreeSpecies(
            id: 3,
            name: "Poor-Drainage Oak",
            drainage: Drainage.PoorlyDrained,
            minimum_root_volume_ft3: 20,
            minimum_overhead_clearance_ft: 10,
            minimum_sidewalk_width_ft: 2,
            establishment_water_liters: 40,
            nursery_stock: 1,
        ),
        TreeSpecies(
            id: 4,
            name: "Well-Drained Ironwood",
            drainage: Drainage.WellDrained,
            minimum_root_volume_ft3: 20,
            minimum_overhead_clearance_ft: 10,
            minimum_sidewalk_width_ft: 2,
            establishment_water_liters: 40,
            nursery_stock: 1,
        ),
    ]
    let species = [unstocked, district_limited, unfit[0], unfit[1]]
    let previous = PlantingDecision(
        site_id: 0,
        site_name: "Earlier Site",
        district_id: site.district_id,
        priority: 0,
        species_id: Some(district_limited.id),
        hold_reason: None,
        establishment_water_liters: district_limited.establishment_water_liters,
    )
    let decisions = [Some(previous), None, None, None, None, None, None, None, None, None]
    let (selected, hold_reason) = choose_species(site, species, [0, 1, 1, 1], decisions, 1, 300, 1)
    assert selected == None
    assert hold_reason == Some(HoldReason.DistrictDiversityLimit)
}
