@derive(Copy, Clone, PartialEq, Eq)
pub enum Category {
    Coffee
    Tea
    Equipment
}

@derive(Copy, Clone, PartialEq, Eq)
pub enum HoldReason {
    None
    UnknownProduct
    InsufficientStock
    MultipleIssues
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Product {
    pub sku: Str
    pub name: Str
    pub category: Category
    pub price_cents: U32
    pub on_hand: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type CartLine {
    pub sku: Str
    pub quantity: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type SalesOrder {
    pub id: U32
    pub customer: Str
    pub lines: Array<CartLine, 2>
    pub requested_discount_cents: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Quote {
    pub order_id: U32
    pub customer: Str
    pub subtotal_cents: U32
    pub discount_cents: U32
    pub tax_cents: U32
    pub total_cents: U32
    pub hold_reason: HoldReason
}
