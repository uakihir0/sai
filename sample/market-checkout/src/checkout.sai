use acme:market-checkout/catalog
use acme:market-checkout/model.{HoldReason, Quote, SalesOrder}
use acme:market-checkout/pricing

pub fn quote(order: SalesOrder) -> Quote {
    var subtotal_cents: U32 = 0
    var unknown_product = false
    var insufficient_stock = false

    for line in order.lines {
        if line.quantity > 0 {
            match catalog.find(line.sku) {
                Some(product) => {
                    subtotal_cents += product.price_cents * line.quantity
                    var requested_sku_quantity: U32 = 0
                    for candidate in order.lines {
                        if candidate.sku == line.sku {
                            requested_sku_quantity += candidate.quantity
                        }
                    }
                    if requested_sku_quantity > product.on_hand {
                        insufficient_stock = true
                    }
                }
                None => {
                    unknown_product = true
                }
            }
        }
    }

    let discount_cents = pricing.applied_discount(
        subtotal_cents,
        order.requested_discount_cents
    )
    let taxable_cents = subtotal_cents - discount_cents
    let tax_cents = pricing.tax_cents(taxable_cents)
    let total_cents = pricing.total_cents(
        subtotal_cents,
        discount_cents,
        tax_cents
    )

    let hold_reason = if unknown_product && insufficient_stock {
        HoldReason.MultipleIssues
    } else if unknown_product {
        HoldReason.UnknownProduct
    } else if insufficient_stock {
        HoldReason.InsufficientStock
    } else {
        HoldReason.None
    }

    Quote(
        order_id: order.id,
        customer: order.customer,
        subtotal_cents: subtotal_cents,
        discount_cents: discount_cents,
        tax_cents: tax_cents,
        total_cents: total_cents,
        hold_reason: hold_reason
    )
}
