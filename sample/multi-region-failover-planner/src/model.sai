pub const MAX_SERVICES: USize = 9
pub const MAX_REGIONS: USize = 3
pub const MAX_TARGETS: USize = 14
pub const MAX_REPLICAS: USize = 13
pub const MAX_DEPENDENCIES: USize = 4

@derive(Copy, Clone, PartialEq, Eq)
pub enum PlanIssue {
    DuplicateServiceId
    DuplicateRegionId
    UnknownPrimaryRegion
    UnknownTargetService
    UnknownTargetRegion
    PrimaryRegionIsTarget
    DuplicateTarget
    UnknownReplicaService
    UnknownReplicaRegion
    DuplicateReplica
    UnknownDependencyEndpoint
    SelfDependency
    DuplicateDependency
    DependencyCycle
}

@derive(Copy, Clone, PartialEq, Eq)
pub enum HoldReason {
    DependenciesUnavailable
    NoRecoveryTarget
    NoReplica
    ReplicaUnavailable
    ReplicaStale
    ReplicaFromFuture
    RecoveryTimeExceeded
    RegionCapacityExceeded
    RecoveryTimeOverflow
}

@derive(Copy, Clone, PartialEq, Eq)
pub enum DecisionState {
    Pending
    Recovered
    Held
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Service {
    pub id: U32
    pub name: Str
    pub primary_region_id: U32
    pub priority: U32
    pub rpo_minutes: U32
    pub rto_minutes: U32
    pub startup_minutes: U32
    pub capacity_units: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Region {
    pub id: U32
    pub name: Str
    pub failover_capacity_units: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type RecoveryTarget {
    pub service_id: U32
    pub region_id: U32
    pub preference: U32
    pub activation_minutes: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Replica {
    pub service_id: U32
    pub region_id: U32
    pub replicated_minute: U32
    pub available: Bool
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Dependency {
    pub service_id: U32
    pub prerequisite_id: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Placement {
    pub service_index: USize
    pub region_index: USize
    pub preference: U32
    pub recovered_minute: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Decision {
    pub service_id: U32
    pub state: DecisionState
    pub region_id: Option<U32>
    pub wave: USize
    pub recovered_minute: Option<U32>
    pub hold_reason: Option<HoldReason>
}

@derive(Copy, Clone, PartialEq, Eq)
pub type PlanReport {
    pub decisions: Array<Option<Decision>, MAX_SERVICES>
    pub decision_count: USize
    pub wave_count: USize
    pub reserved_units_by_region: Array<U32, MAX_REGIONS>
    pub issue: Option<PlanIssue>
}
