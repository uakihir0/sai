use acme:event-planner/data
use acme:event-planner/model.{Registration, Session}
use acme:event-planner/planner
use sai:core/fmt.{Writer}
use sai:process.{Stdout}

fn attendee_name(id: U32) -> Str {
    match planner.find_attendee(id) {
        Some(attendee) => attendee.name
        None => "(unknown attendee)"
    }
}

fn session_title(id: U32) -> Str {
    match planner.find_session(id) { Some(session) => session.title, None => "(unknown session)" }
}

fn registration_status(registration: Registration) -> Str {
    if planner.is_confirmed(registration) {
        "confirmed"
    } else {
        "waitlisted"
    }
}

fn print_session(out: borrow mut Stdout, session: Session)
    effects { stdio.write, alloc }
{
    let registered = planner.registration_count(session.id)
    out.write_str(
        f"{session.start_time}-{session.end_time} {session.title} ({session.room})\n".as_str(),
    )
    out.write_str(
        f"  registered: {registered}, confirmed: {planner.confirmed_count(session.id)}, waitlisted: {planner.waitlisted_count(session.id)}, open seats: {planner.open_seats(session.id)}\n".as_str(),
    )
}

pub fn print_sessions(out: borrow mut Stdout)
    effects { stdio.write, alloc }
{
    out.write_str("Event sessions\n")
    for session in data.sessions() {
        print_session(borrow mut out, session)
    }
}

pub fn print_registrations(out: borrow mut Stdout)
    effects { stdio.write, alloc }
{
    out.write_str("Registrations (first come, first served)\n")
    for registration in data.registrations() {
        out.write_str(
            f"#{registration.sequence} {attendee_name(registration.attendee_id)} -> {session_title(registration.session_id)} [{registration_status(registration)}]\n".as_str(),
        )
    }
}

pub fn print_summary(out: borrow mut Stdout)
    effects { stdio.write, alloc }
{
    var confirmed: U32 = 0
    var waitlisted: U32 = 0
    var open_seats: U32 = 0
    for session in data.sessions() {
        confirmed += planner.confirmed_count(session.id)
        waitlisted += planner.waitlisted_count(session.id)
        open_seats += planner.open_seats(session.id)
    }

    out.write_str(
        f"{data.sessions().len()} sessions and {data.attendees().len()} attendees\n".as_str(),
    )
    out.write_str(
        f"confirmed registrations: {confirmed}, waitlisted registrations: {waitlisted}, open seats: {open_seats}\n".as_str(),
    )
    out.write_str(f"confirmed schedule conflicts: {planner.confirmed_conflict_count()}\n".as_str())
}

pub fn print_conflicts(out: borrow mut Stdout)
    effects { stdio.write, alloc }
{
    var printed: U32 = 0
    for first in data.registrations() {
        for second in data.registrations() {
            if (
                first.sequence < second.sequence
                and first.attendee_id == second.attendee_id
                and first.session_id != second.session_id
                and planner.is_confirmed(first)
                and planner.is_confirmed(second)
            ) {
                match planner.find_session(first.session_id) {
                    Some(first_session) => {
                        match planner.find_session(second.session_id) {
                            Some(second_session) => {
                                if planner.overlaps(first_session, second_session) {
                                    out.write_str(
                                        f"{attendee_name(first.attendee_id)} is confirmed for {first_session.title} ({first_session.start_time}-{first_session.end_time}) and {second_session.title} ({second_session.start_time}-{second_session.end_time}); the sessions overlap.\n".as_str(),
                                    )
                                    printed += 1
                                }
                            }
                            None => {}
                        }
                    }
                    None => {}
                }
            }
        }
    }
    if printed == 0 {
        out.write_str("No confirmed attendee schedule conflicts.\n")
    }
}
