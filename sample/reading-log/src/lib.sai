use acme:reading-log/report
use sai:core/fmt.{Writer}
use sai:process

pub fn main(env: owned process.Env) -> process.ExitCode
    effects { env.read, stdio.write, alloc }
{
    var out = env.stdout()
    let args = env.args()
    if args.len() < 2 {
        report.print_list(borrow mut out)
        return process.ExitCode.success()
    }

    let command = args[1].as_str()
    if command == "list" {
        report.print_list(borrow mut out)
        return process.ExitCode.success()
    }
    if command == "progress" {
        report.print_progress(borrow mut out)
        return process.ExitCode.success()
    }
    if command == "next" {
        report.print_next(borrow mut out)
        return process.ExitCode.success()
    }

    out.write_str("usage: reading-log [list|progress|next]\n")
    process.ExitCode.failure()
}
