@derive(Copy, Clone, PartialEq, Eq)
pub enum Status {
    ToRead
    Reading
    Finished
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Book {
    pub title: Str
    pub author: Str
    pub total_pages: U32
    pub pages_read: U32
    pub status: Status
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Summary {
    pub pages_read: U32
    pub total_pages: U32
    pub reading_count: USize
    pub finished_count: USize
    pub queued_count: USize
}
