}

pub fn current_loans() -> Array<CurrentLoan, 4> {
    [
        CurrentLoan(member_id: 1, tool_id: 1, return_day: 2),
        CurrentLoan(member_id: 2, tool_id: 1, return_day: 4),
        CurrentLoan(member_id: 3, tool_id: 2, return_day: 1),
        CurrentLoan(member_id: 4, tool_id: 2, return_day: 3),
    ]
}

// Requests are already sorted by queue_number; earlier rows win shared copies.
