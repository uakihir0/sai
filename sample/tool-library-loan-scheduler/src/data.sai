use acme:tool-library-loan-scheduler/model.{CurrentLoan, Member, Request, Tool, Training}

pub fn tools() -> Array<Tool, 3> {
    [
        Tool(
            id: 1,
            name: "cordless drill",
            total_copies: 4,
            ready_copies: 1,
            maintenance_copies: 1,
            max_loan_days: 4,
            required_training: Training.Drill,
        ),
        Tool(
            id: 2,
            name: "circular saw",
            total_copies: 3,
            ready_copies: 0,
            maintenance_copies: 1,
            max_loan_days: 3,
            required_training: Training.Saw,
        ),
        Tool(
            id: 3,
            name: "hand truck",
            total_copies: 2,
            ready_copies: 2,
            maintenance_copies: 0,
            max_loan_days: 5,
            required_training: Training.None,
        ),
    ]
}

pub fn members() -> Array<Member, 5> {
    [
        Member(id: 1, name: "Aiko", max_concurrent_loans: 2, drill_badge: true, saw_badge: true),
        Member(id: 2, name: "Ben", max_concurrent_loans: 1, drill_badge: true, saw_badge: false),
        Member(id: 3, name: "Chika", max_concurrent_loans: 2, drill_badge: true, saw_badge: false),
