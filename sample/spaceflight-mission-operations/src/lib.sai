use acme:spaceflight-mission-operations/data
use acme:spaceflight-mission-operations/model.{
    GraphIssue
    MissionLimits
    MissionPlan
    PlanIssue
    PlanningIssue
    TaskState
}
use acme:spaceflight-mission-operations/planner
use sai:core/num.{U32_MAX}

pub fn fixture_plan() -> MissionPlan {
    planner.plan(data.tasks(), data.dependencies(), data.crew_windows(), data.limits())
}

test "the mission chain is ordered and scheduled within crew and resource limits" {
    let report = fixture_plan()

    assert report.graph_issue == None
    assert report.order_length == 12
    assert report.task_order[0] == Some(1)
    assert report.task_order[1] == Some(2)
    assert report.task_order[2] == Some(4)
    assert report.task_order[3] == Some(3)
    assert report.task_order[4] == Some(5)
    assert report.task_order[5] == Some(7)
    assert report.task_order[6] == Some(8)
    assert report.scheduled_count == 7
    assert report.blocked_count == 1
    assert report.unplaced_count == 4
}

test "the deterministic timeline delays battery balance until power is available" {
    let first = fixture_plan()
    let second = fixture_plan()

    assert first == second
    assert first.decisions[0].unwrap().start_slot == Some(0)
    assert first.decisions[1].unwrap().start_slot == Some(4)
    assert first.decisions[2].unwrap().start_slot == Some(8)
    assert first.decisions[3].unwrap().start_slot == Some(10)
    assert first.decisions[4].unwrap().start_slot == Some(20)
    assert first.decisions[5].unwrap().start_slot == Some(23)
    assert first.decisions[6].unwrap().start_slot == Some(25)
}

test "the report names capacity, crew-window, and prerequisite failures" {
    let report = fixture_plan()

    assert report.decisions[7].unwrap().issue == Some(PlanIssue.NoCrewWindow)
    assert report.decisions[8].unwrap().issue == Some(PlanIssue.ExceedsPowerCapacity)
    assert report.decisions[9].unwrap().issue == Some(PlanIssue.ExceedsThermalCapacity)
    assert (report.decisions[10].unwrap().issue == Some(PlanIssue.PrerequisiteNotScheduled))
    assert (report.decisions[11].unwrap().issue == Some(PlanIssue.CrewPowerAndThermalConflict))
}

test "a dependency cycle rejects the plan before producing a partial timeline" {
    var dependencies = data.dependencies()
    dependencies[0].task_id = 1
    dependencies[0].prerequisite_id = 2

    let report = planner.plan(data.tasks(), dependencies, data.crew_windows(), data.limits())

    assert report.graph_issue == Some(GraphIssue.DependencyCycle)
    assert report.order_length == 0
    assert report.decision_count == 0
    assert report.scheduled_count == 0
}

test "an oversized horizon is rejected before graph search" {
    var limits = data.limits()
    limits.planning_horizon_slots = 33
    var dependencies = data.dependencies()
    dependencies[0].task_id = 1
    dependencies[0].prerequisite_id = 2

    let report = planner.plan(data.tasks(), dependencies, data.crew_windows(), limits)

    assert report.planning_issue == Some(PlanningIssue.HorizonExceedsCapacity)
    assert report.graph_issue == None
    assert report.order_length == 0
    assert report.decision_count == 0
}

test "overlapping half-range loads conflict without overflowing the U32 cap" {
    var tasks = data.tasks()
    tasks[1].power_watts = 0x8000_0000
    tasks[1].thermal_units = 0x8000_0000
    tasks[2].power_watts = 0x8000_0000
    tasks[2].thermal_units = 0x8000_0000
    tasks[2].latest_finish_slot = 5
    let limits = MissionLimits(
        planning_horizon_slots: 32,
        max_power_watts: U32_MAX,
        max_thermal_units: U32_MAX,
    )

    let report = planner.plan(tasks, data.dependencies(), data.crew_windows(), limits)

    assert report.decisions[3].unwrap().task_id == 3
    assert report.decisions[3].unwrap().state == TaskState.Unplaced
    assert report.decisions[3].unwrap().issue == Some(PlanIssue.PowerAndThermalConflict)
}
