use acme:incident-response-console/report
use sai:core/fmt.{Writer}
use sai:process

pub fn main(env: owned process.Env) -> process.ExitCode
    effects { env.read, stdio.write, alloc }
{
    var out = env.stdout()
    let args = env.args()
    if args.len() < 2 {
        report.print_incidents(borrow mut out)
        return process.ExitCode.success()
    }

    let command = args[1].as_str()
    if command == "incidents" {
        report.print_incidents(borrow mut out)
        return process.ExitCode.success()
    }
    if command == "escalations" {
        report.print_escalations(borrow mut out)
        return process.ExitCode.success()
    }
    if command == "summary" {
        report.print_summary(borrow mut out)
        return process.ExitCode.success()
    }

    out.write_str("usage: incident-response-console [incidents|escalations|summary]\n")
    process.ExitCode.failure()
}
