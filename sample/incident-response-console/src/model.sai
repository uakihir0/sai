@derive(Copy, Clone, PartialEq, Eq)
pub enum Severity {
    Critical
    High
    Medium
    Low
}

@derive(Copy, Clone, PartialEq, Eq)
pub enum Impact {
    Widespread
    ManyCustomers
    SingleCustomer
    InternalOnly
}

@derive(Copy, Clone, PartialEq, Eq)
pub enum Priority {
    P1
    P2
    P3
    P4
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Incident {
    pub id: Str
    pub service: Str
    pub summary: Str
    pub severity: Severity
    pub impact: Impact
    pub detected_minutes_ago: U32
    pub first_response_minutes: Option<U32>
}
