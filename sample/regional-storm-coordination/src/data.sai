use acme:regional-storm-coordination/model.{Capability, Mission, Priority, ResponseUnit}

// Critical work is listed first. A dependent mission can be delayed until a
// prerequisite later in this stable list has been dispatched.
pub fn missions() -> Array<Mission, 6> {
    [
        Mission(
            id: 802,
            label: "Energize Hilltop cooling center",
            priority: Priority.Critical,
            capability: Capability.Electrical,
            origin_zone: 3,
            destination_zone: 3,
            load_units: 0,
            earliest_minute: 360,
            due_minute: 420,
            service_minutes: 20,
            depends_on: None,
        ),
        Mission(
            id: 803,
            label: "Move Eastbank residents to Hilltop",
            priority: Priority.Critical,
            capability: Capability.AccessibleTransport,
            origin_zone: 1,
            destination_zone: 3,
            load_units: 8,
            earliest_minute: 360,
            due_minute: 450,
            service_minutes: 15,
            depends_on: Some(801),
        ),
        Mission(
