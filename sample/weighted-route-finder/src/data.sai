use acme:weighted-route-finder/model.{Edge, Network, Node}
use sai:core/num.{U32_MAX}

pub fn downtown() -> Network {
    Network(
        nodes: [
            Node(id: 101, name: "Depot"),
            Node(id: 202, name: "River Crossing"),
            Node(id: 303, name: "Old Bridge"),
            Node(id: 404, name: "Civic Square"),
            Node(id: 505, name: "Hospital"),
            Node(id: 606, name: "Terminal"),
        ],
        edges: [
            Some(Edge(from_index: 0, to_index: 1, minutes: 6)),
            Some(Edge(from_index: 0, to_index: 2, minutes: 4)),
            Some(Edge(from_index: 2, to_index: 1, minutes: 1)),
            Some(Edge(from_index: 1, to_index: 3, minutes: 4)),
            Some(Edge(from_index: 2, to_index: 3, minutes: 7)),
            Some(Edge(from_index: 3, to_index: 4, minutes: 3)),
            Some(Edge(from_index: 1, to_index: 4, minutes: 14)),
            Some(Edge(from_index: 4, to_index: 5, minutes: 5)),
            Some(Edge(from_index: 3, to_index: 5, minutes: 12)),
            Some(Edge(from_index: 2, to_index: 5, minutes: 20)),
        ],
    )
}

