@derive(Copy, Clone, PartialEq, Eq)
pub type Node {
    pub id: U32
    pub name: Str
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Edge {
    pub from_index: USize
    pub to_index: USize
    pub minutes: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Network {
    pub nodes: Array<Node, 6>
    pub edges: Array<Option<Edge>, 10>
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Route {
    pub node_ids: Array<Option<U32>, 6>
    pub length: USize
    pub minutes: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub enum RouteError {
    UnknownOrigin
    UnknownDestination
    Unreachable
}
