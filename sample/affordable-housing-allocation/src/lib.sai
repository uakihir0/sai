use acme:affordable-housing-allocation/report
use sai:core/fmt.{Writer}
use sai:process

pub fn main(env: owned process.Env) -> process.ExitCode
    effects { env.read, stdio.write, alloc }
{
    var out = env.stdout()
    let args = env.args()
    if args.len() < 2 {
        report.print_assignments(borrow mut out)
        return process.ExitCode.success()
    }

    let command = args[1].as_str()
    if command == "allocations" {
        report.print_assignments(borrow mut out)
        return process.ExitCode.success()
    }
    if command == "waitlist" {
        report.print_waitlist(borrow mut out)
        return process.ExitCode.success()
    }
    if command == "summary" {
        report.print_summary(borrow mut out)
        return process.ExitCode.success()
    }

    out.write_str("usage: affordable-housing-allocation [allocations|waitlist|summary]\n")
    process.ExitCode.failure()
}
