}

pub fn service_day() -> U32 {
    18
}

pub fn school_policy() -> SchoolPolicy {
    SchoolPolicy(
        enrolled_students: 96,
        reserve_portions: 4,
        avoid_peanuts: true,
        avoid_sesame: true,
        avoid_dairy: false,
        avoid_wheat: false,
        minimum_calories: 500,
        maximum_calories: 700,
        minimum_protein_grams: 18,
        maximum_protein_grams: 32,
        daily_budget_cents: 7800,
    )
}

pub fn kitchen_capacity() -> KitchenCapacity {
    KitchenCapacity(portions_per_batch: 60, available_prep_minutes: 90)
}

