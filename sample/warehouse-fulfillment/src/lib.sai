use acme:warehouse-fulfillment/report
use sai:core/fmt.{Writer}
use sai:process

pub fn main(env: owned process.Env) -> process.ExitCode
    effects { env.read, stdio.write, alloc }
{
    var out = env.stdout()
    let args = env.args()
    if args.len() < 2 {
        report.print_summary(borrow mut out)
        return process.ExitCode.success()
    }

    let command = args[1].as_str()
    if command == "plan" {
        report.print_plan(borrow mut out)
        return process.ExitCode.success()
    }
    if command == "inventory" {
        report.print_inventory(borrow mut out)
        return process.ExitCode.success()
    }
    if command == "lanes" {
        report.print_lanes(borrow mut out)
        return process.ExitCode.success()
    }
    if command == "summary" {
        report.print_summary(borrow mut out)
        return process.ExitCode.success()
    }

    out.write_str("usage: warehouse-fulfillment [plan|inventory|lanes|summary]\n")
    process.ExitCode.failure()
}
