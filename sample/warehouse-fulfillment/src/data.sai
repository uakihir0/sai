            priority: 1,
            requested_delivery_by_day: 41,
            max_transit_days: 1,
            lines: [
                OrderLine(sku: "LANTERN", quantity: 3),
                OrderLine(sku: "TAPE", quantity: 1),
                OrderLine(sku: "TAPE", quantity: 0),
            ],
        ),
        FulfillmentOrder(
