use acme:vaccine-cold-chain-release-auditor/model.{
    AuditInput
    ColdChainLot
    LoggerCalibration
    Shipment
    TemperatureInterval
}

fn interval(start_minute: U32, end_minute: U32, low_tenths_c: I32, high_tenths_c: I32) -> Option<
    TemperatureInterval,
> {
    Some(
        TemperatureInterval(
            start_minute: start_minute,
            end_minute: end_minute,
            low_tenths_c: low_tenths_c,
            high_tenths_c: high_tenths_c,
        ),
    )
}

pub fn sample_input() -> AuditInput {
    AuditInput(
        review_day: 400,
        lots: [
            Some(ColdChainLot(id: "LOT-A", expiration_day: 420, available_doses: 1200)),
            Some(ColdChainLot(id: "LOT-B", expiration_day: 430, available_doses: 500)),
            Some(ColdChainLot(id: "LOT-C", expiration_day: 395, available_doses: 100)),
        ],
        lot_count: 3,
        calibrations: [
            Some(
                LoggerCalibration(
                    logger_id: "LOGGER-A",
                    certificate_present: true,
                    calibration_passed: true,
                    valid_from_day: 390,
                    valid_through_day: 430,
                ),
