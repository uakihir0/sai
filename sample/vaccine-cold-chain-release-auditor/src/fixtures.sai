                        None,
                        None,
                        None,
                    ],
                    interval_count: 4,
                    pickup_evidence_present: true,
                    carrier_handoff_present: false,
                    delivery_evidence_present: true,
                    custody_chain_intact: false,
                    seal_intact: false,
