            ),
            Some(
                Shipment(
                    id: "CC-702",
                    lot_id: "LOT-A",
                    doses: 600,
                    logger_id: Some("LOGGER-A"),
                    transit_minutes: 60,
                    intervals: [
                        interval(0, 10, 50, 60),
                        interval(10, 20, 50, 60),
                        interval(20, 30, 90, 100),
                        interval(30, 40, 50, 60),
                        interval(40, 60, 50, 60),
                        None,
