                    pickup_evidence_present: true,
                    carrier_handoff_present: true,
                    delivery_evidence_present: true,
                    custody_chain_intact: true,
                    seal_intact: true,
                ),
            ),
            Some(
                Shipment(
                    id: "CC-703",
                    lot_id: "LOT-B",
                    doses: 300,
