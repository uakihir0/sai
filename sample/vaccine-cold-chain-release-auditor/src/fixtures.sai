            ),
            Some(
                Shipment(
                    id: "CC-704",
                    lot_id: "LOT-C",
                    doses: 50,
                    logger_id: Some("LOGGER-C"),
                    transit_minutes: 80,
                    intervals: [
                        interval(0, 10, 50, 60),
                        interval(10, 80, 110, 120),
                        None,
