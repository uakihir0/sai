use acme:observatory-night-planner/model.{
    Filter
    NightConditions
    ObservationRequest
    Target
    Telescope
}

pub fn north_dome_telescope() -> Telescope {
    Telescope(
        name: "North Dome",
        supports_luminance: true,
        supports_h_alpha: true,
        supports_planetary: true,
        guiding_unit_available: false,
    )
}

pub fn observing_conditions() -> NightConditions {
    NightConditions(dark_start_minute: 0, dark_end_minute: 210, cloud_percent: 18)
}

pub fn targets() -> Array<Target, 8> {
    [
        Target(id: 1, name: "Comet Vesper-7", visible_start_minute: 0, visible_end_minute: 50),
        Target(id: 2, name: "Andromeda Galaxy", visible_start_minute: 0, visible_end_minute: 130),
        Target(id: 3, name: "Rosette Nebula", visible_start_minute: 45, visible_end_minute: 180),
        Target(id: 4, name: "Jupiter", visible_start_minute: 85, visible_end_minute: 200),
        Target(id: 5, name: "M13", visible_start_minute: 15, visible_end_minute: 120),
        Target(id: 6, name: "Pleiades", visible_start_minute: 20, visible_end_minute: 180),
        Target(id: 7, name: "Crab Nebula", visible_start_minute: 170, visible_end_minute: 210),
        Target(id: 8, name: "Helix Galaxy", visible_start_minute: 0, visible_end_minute: 200),
    ]
}

