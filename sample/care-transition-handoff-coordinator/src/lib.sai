use acme:care-transition-handoff-coordinator/coordinator
use acme:care-transition-handoff-coordinator/data
use acme:care-transition-handoff-coordinator/model.{Action, CoordinationPlan, Team}

pub fn fixture_plan() -> CoordinationPlan {
    coordinator.coordinate()
}

test "cases are coordinated by priority, departure time, and ID" {
    let plan = fixture_plan()
    assert plan.service_order[0] == 1
    assert plan.service_order[1] == 3
    assert plan.service_order[2] == 4
    assert plan.service_order[3] == 0
    assert plan.service_order[4] == 2
    assert plan.service_order[5] == 5
}

test "clinical clearance blocks all downstream handoffs" {
    let plan = fixture_plan()
    assert plan.decisions[1].action == Action.AwaitClinicalClearance
    assert plan.decisions[1].owner == Team.Attending
    assert plan.decisions[1].handoff_index == None
}

test "returned and expired pharmacy evidence route to the pharmacy team" {
    let plan = fixture_plan()
    assert plan.decisions[3].action == Action.CorrectReturnedHandoff
    assert plan.decisions[3].owner == Team.Pharmacy
    assert plan.decisions[4].action == Action.RefreshExpiredEvidence
    assert plan.decisions[4].owner == Team.Pharmacy
}

test "a current pharmacy confirmation advances to a pending transport handoff" {
    let plan = fixture_plan()
    assert plan.decisions[0].action == Action.AwaitHandoffResponse
    assert plan.decisions[0].owner == Team.Transport
    assert plan.decisions[0].handoff_index == Some(1)
}

test "optional returned handoffs do not block discharge desk readiness" {
    let plan = fixture_plan()
    assert plan.decisions[2].action == Action.ReadyForDischargeDesk
    assert plan.decisions[2].owner == Team.DischargeDesk
    assert plan.decisions[2].handoff_index == None
}

test "an unstarted required component gets the next action" {
    let plan = fixture_plan()
    assert plan.decisions[5].action == Action.RequestHandoff
    assert plan.decisions[5].owner == Team.Pharmacy
    assert plan.decisions[5].handoff_index == Some(0)
}

test "fixture outcomes are exhaustively classified" {
    let plan = fixture_plan()
    assert plan.awaiting_team_count == 2
    assert plan.action_required_count == 3
    assert plan.ready_count == 1
    assert (
        plan.awaiting_team_count + plan.action_required_count + plan.ready_count
        == data.cases().len()
    )
}
