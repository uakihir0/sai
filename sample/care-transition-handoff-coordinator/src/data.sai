use acme:care-transition-handoff-coordinator/model.{
    Action
    CoordinationDecision
    DischargeCase
    Handoff
    HandoffStatus
    Team
}

pub fn fixture_minute() -> U32 {
    600
}

fn handoff(
    team: Team,
    required: Bool,
    status: HandoffStatus,
    evidence_expires_minute: Option<U32>,
) -> Handoff {
    Handoff(
        team: team,
        required: required,
        status: status,
        evidence_expires_minute: evidence_expires_minute,
    )
}

