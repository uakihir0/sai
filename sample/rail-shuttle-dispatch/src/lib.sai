use acme:rail-shuttle-dispatch/report
use sai:core/fmt.{Writer}
use sai:process

pub fn main(env: owned process.Env) -> process.ExitCode
    effects { env.read, stdio.write, alloc }
{
    var out = env.stdout()
    let args = env.args()
    if args.len() < 2 {
        report.print_plan(borrow mut out)
        return process.ExitCode.success()
    }

    let command = args[1].as_str()
    if command == "plan" {
        report.print_plan(borrow mut out)
        return process.ExitCode.success()
    }
    if command == "shortfalls" {
        report.print_shortfalls(borrow mut out)
        return process.ExitCode.success()
    }
    if command == "fleet" {
        report.print_fleet(borrow mut out)
        return process.ExitCode.success()
    }

    out.write_str("usage: rail-shuttle-dispatch [plan|shortfalls|fleet]\n")
    process.ExitCode.failure()
}
