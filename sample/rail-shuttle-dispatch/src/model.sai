@derive(Copy, Clone, PartialEq, Eq)
pub enum Corridor {
    EastLink
    NorthLoop
    WestBranch
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Vehicle {
    pub id: U32
    pub name: Str
    pub corridor: Corridor
    pub seat_capacity: U32
    pub wheelchair_bays: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type ServiceRequest {
    pub id: U32
    pub stop: Str
    pub corridor: Corridor
    pub priority: U32
    pub passengers: U32
    pub wheelchair_bays_needed: U32
}

@derive(Copy, Clone, PartialEq, Eq)
pub type Assignment {
    pub request: ServiceRequest
    pub vehicle: Option<Vehicle>
}
