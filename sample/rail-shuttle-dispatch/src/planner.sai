use acme:rail-shuttle-dispatch/data
use acme:rail-shuttle-dispatch/model.{Assignment, ServiceRequest, Vehicle}

fn precedes(candidate: ServiceRequest, request: ServiceRequest) -> Bool {
    candidate.priority < request.priority
        or (candidate.priority == request.priority and candidate.id < request.id)
}

fn is_compatible(vehicle: Vehicle, request: ServiceRequest) -> Bool {
    (
        vehicle.corridor == request.corridor
        and vehicle.seat_capacity >= request.passengers
        and vehicle.wheelchair_bays >= request.wheelchair_bays_needed
    )
}

fn improves_fit(candidate: Vehicle, current: Vehicle, request: ServiceRequest) -> Bool {
    let candidate_seat_slack = candidate.seat_capacity - request.passengers
    let current_seat_slack = current.seat_capacity - request.passengers
    let candidate_bay_slack = candidate.wheelchair_bays - request.wheelchair_bays_needed
    let current_bay_slack = current.wheelchair_bays - request.wheelchair_bays_needed
    (
        candidate_seat_slack < current_seat_slack
        or (
            candidate_seat_slack == current_seat_slack
            and (
                candidate_bay_slack < current_bay_slack
                or (
                    candidate_bay_slack == current_bay_slack
                    and candidate.id < current.id
                )
            )
        )
    )
}

// Only requests that precede this one can have reserved a vehicle. The
// recursive lookup always moves to a lower-priority-ranked request, so the
// fixed fixture has a deterministic, mutation-free greedy plan.
fn reserved_by_prior_request(vehicle_id: U32, request: ServiceRequest) -> Bool {
    var reserved = false
    for prior in data.requests() {
        if precedes(prior, request) {
            match select_vehicle(prior) {
                Some(vehicle) => {
                    if vehicle.id == vehicle_id {
                        reserved = true
                    }
                }
                None => {}
            }
        }
    }
    reserved
}

fn select_vehicle(request: ServiceRequest) -> Option<Vehicle> {
    var selected: Option<Vehicle> = None
    for vehicle in data.vehicles() {
        if is_compatible(vehicle, request) and not reserved_by_prior_request(vehicle.id, request) {
            match selected {
                Some(current) => {
                    if improves_fit(vehicle, current, request) {
                        selected = Some(vehicle)
                    }
                }
                None => {
                    selected = Some(vehicle)
                }
            }
        }
    }
    selected
}

pub fn assignment(request: ServiceRequest) -> Assignment {
    Assignment(
        request: request,
        vehicle: select_vehicle(request),
    )
}

fn corridor_vehicle_count(request: ServiceRequest) -> U32 {
    var count: U32 = 0
    for vehicle in data.vehicles() {
        if vehicle.corridor == request.corridor {
            count += 1
        }
    }
    count
}

fn corridor_capacity_candidate_count(request: ServiceRequest) -> U32 {
    var count: U32 = 0
    for vehicle in data.vehicles() {
        if (
            vehicle.corridor == request.corridor
            and vehicle.seat_capacity >= request.passengers
        ) {
            count += 1
        }
    }
    count
}

fn corridor_accessible_candidate_count(request: ServiceRequest) -> U32 {
    var count: U32 = 0
    for vehicle in data.vehicles() {
        if is_compatible(vehicle, request) {
            count += 1
        }
    }
    count
}

pub fn unserved_reason(request: ServiceRequest) -> Str {
    if corridor_vehicle_count(request) == 0 {
        "no vehicle serves this corridor"
    } else if corridor_capacity_candidate_count(request) == 0 {
        "seat capacity is too small"
    } else if corridor_accessible_candidate_count(request) == 0 {
        "wheelchair bay requirement exceeds corridor fleet"
    } else {
        "all compatible vehicles are assigned to higher-priority requests"
    }
}

pub fn assigned_count() -> U32 {
    var count: U32 = 0
    for request in data.requests() {
        match select_vehicle(request) {
            Some(_) => {
                count += 1
            }
            None => {}
        }
    }
    count
}

pub fn unserved_count() -> U32 {
    data.requests().len() - assigned_count()
}

pub fn passengers_assigned() -> U32 {
    var count: U32 = 0
    for request in data.requests() {
        match select_vehicle(request) {
            Some(_) => {
                count += request.passengers
            }
            None => {}
        }
    }
    count
}

pub fn passengers_unserved() -> U32 {
    var count: U32 = 0
    for request in data.requests() {
        match select_vehicle(request) {
            Some(_) => {}
            None => {
                count += request.passengers
            }
        }
    }
    count
}
