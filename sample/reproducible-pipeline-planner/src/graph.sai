use acme:reproducible-pipeline-planner/lookup
use acme:reproducible-pipeline-planner/model.{
    Dependency
    GraphIssue
    MAX_DEPENDENCIES
    MAX_TASKS
    Task
}

fn task_exists(tasks: Array<Task, MAX_TASKS>, task_id: U32) -> Bool {
    match lookup.task_index(tasks, task_id) { Some(_) => true, None => false }
}

fn prerequisites_are_ordered(
    tasks: Array<Task, MAX_TASKS>,
    dependencies: Array<Dependency, MAX_DEPENDENCIES>,
    task_id: U32,
    ordered: Array<Bool, MAX_TASKS>,
) -> Bool {
    for dependency in dependencies {
        if dependency.task_id == task_id {
            match lookup.task_index(tasks, dependency.prerequisite_id) {
                Some(index) => {
                    if not ordered[index] {
                        return false
                    }
                }
                None => {
                    return false
                }
            }
        }
    }
    true
}

pub fn validate(
    tasks: Array<Task, MAX_TASKS>,
    dependencies: Array<Dependency, MAX_DEPENDENCIES>,
) -> Option<GraphIssue> {
    for index in 0..tasks.len() {
        for other_index in (index + 1)..tasks.len() {
            if tasks[index].id == tasks[other_index].id {
                return Some(GraphIssue.DuplicateTaskId)
            }
        }
    }

    for index in 0..dependencies.len() {
        let dependency = dependencies[index]
        if dependency.task_id == dependency.prerequisite_id {
            return Some(GraphIssue.SelfDependency)
        }
        if (
            not task_exists(tasks, dependency.task_id)
            or not task_exists(tasks, dependency.prerequisite_id)
        ) {
            return Some(GraphIssue.UnknownDependencyEndpoint)
        }
        for other_index in (index + 1)..dependencies.len() {
            if (
                dependencies[other_index].task_id == dependency.task_id
                and dependencies[other_index].prerequisite_id == dependency.prerequisite_id
            ) {
                return Some(GraphIssue.DuplicateDependency)
            }
        }
    }

    var ordered = Array<Bool, MAX_TASKS>.filled(false)
    var ordered_count: USize = 0
    var stuck = false
    while ordered_count < tasks.len() and not stuck {
        var selected: Option<USize> = None
        for index in 0..tasks.len() {
            if (
                not ordered[index]
                and prerequisites_are_ordered(tasks, dependencies, tasks[index].id, ordered)
            ) {
                match selected {
                    Some(selected_index) => {
                        if tasks[index].id < tasks[selected_index].id {
                            selected = Some(index)
                        }
                    }
                    None => {
                        selected = Some(index)
                    }
                }
            }
        }
        match selected {
            Some(index) => {
                ordered[index] = true
                ordered_count += 1
            }
            None => {
                stuck = true
            }
        }
    }

    if ordered_count < tasks.len() {
        Some(GraphIssue.DependencyCycle)
    } else {
        None
    }
}
