        Dependency(task_id: 20, prerequisite_id: 10),
        Dependency(task_id: 30, prerequisite_id: 10),
        Dependency(task_id: 40, prerequisite_id: 20),
        Dependency(task_id: 40, prerequisite_id: 30),
        Dependency(task_id: 50, prerequisite_id: 40),
        Dependency(task_id: 60, prerequisite_id: 30),
        Dependency(task_id: 80, prerequisite_id: 70),
        Dependency(task_id: 90, prerequisite_id: 50),
        Dependency(task_id: 90, prerequisite_id: 80),
        Dependency(task_id: 100, prerequisite_id: 20),
        Dependency(task_id: 100, prerequisite_id: 30),
        Dependency(task_id: 110, prerequisite_id: 10),
