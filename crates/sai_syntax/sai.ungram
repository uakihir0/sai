# Direct child roles: child selects by zero-based same-type position; child_before and
# child_after select relative to a direct token boundary; children is repeated, and token
# names an AstToken.
children SourceFile items Item
children SourceFile test_decls TestDecl
children SourceFile property_decls PropertyDecl
child FnDecl name Name 0
child FnDecl params ParamList 0
child FnDecl ret_type RetType 0
child FnDecl body Block 0
token TestDecl name StringLit
child TestDecl body Block 0
token PropertyDecl name StringLit
child PropertyDecl params ParamList 0
child PropertyDecl body Block 0
children ParamList params Param
child Param name Name 0
child Param ty Type 0
child RetType ty Type 0
children Block statements Stmt
child LetStmt pattern Pattern 0
child LetStmt ty Type 0
child LetStmt initializer Expr 0
child LetStmt else_clause LetElse 0
child VarStmt name Name 0
child VarStmt ty Type 0
child VarStmt initializer Expr 0
child AssignStmt lhs Expr 0
child AssignStmt rhs Expr 1
child_before AssertStmt condition Expr COMMA 0
child_after AssertStmt message Expr COMMA 0
child ExprStmt expression Expr 0
child IfExpr condition Condition 0
child IfExpr then_branch Block 0
child IfExpr else_branch ElseBranch 0
child ElseBranch block Block 0
child ElseBranch else_if IfExpr 0
child Condition expression Expr 0
child Condition let_condition LetCondition 0
child LetCondition pattern Pattern 0
child LetCondition initializer Expr 0
child MatchExpr scrutinee Expr 0
child MatchExpr arms MatchArmList 0
children MatchArmList arms MatchArm
child MatchArm pattern Pattern 0
child MatchArm guard MatchGuard 0
child MatchArm expression Expr 0
child MatchGuard expression Expr 0
child LoopExpr label LoopLabel 0
child LoopExpr body Block 0
child WhileExpr label LoopLabel 0
child WhileExpr condition Condition 0
child WhileExpr body Block 0
child ForExpr label LoopLabel 0
child ForExpr pattern Pattern 0
child ForExpr iterable Expr 0
child ForExpr body Block 0
child ClosureExpr params ClosureParamList 0
child ClosureExpr ret_type RetType 0
child ClosureExpr body Block 0
children ClosureParamList params ClosureParam
child ClosureParam name Name 0
child ClosureParam ty Type 0
child RegionExpr name Name 0
child RegionExpr body Block 0
child BlockExpr block Block 0
child UnsafeBlockExpr body Block 0
child AsyncBlockExpr body Block 0
child ReturnExpr value Expr 0
child BreakExpr value Expr 0
child PrefixExpr operand Expr 0
child BinExpr lhs Expr 0
child BinExpr rhs Expr 1
